# Copy to .env. Never commit .env.

# GitHub personal access token, read-only. Classic token with `public_repo`, or a
# fine-grained token with Contents:read + Pull requests:read + Issues:read + Metadata:read.
# Required to sync real repositories. The demo repository works without it.
LOUPE_GITHUB_TOKEN=

# LLM provider: anthropic | bedrock | mock
# `mock` needs no key and produces deterministic, fact-grounded narratives (used by tests/evals).
LOUPE_LLM_PROVIDER=anthropic
LOUPE_ANTHROPIC_API_KEY=
LOUPE_ANTHROPIC_MODEL=claude-sonnet-4-5

# For bedrock: standard AWS credential chain (AWS_PROFILE / AWS_ACCESS_KEY_ID ...) plus:
# LOUPE_AWS_REGION=us-east-1
# LOUPE_BEDROCK_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0

# Sync tuning
LOUPE_BACKFILL_DAYS=180
LOUPE_SYNC_INTERVAL_MINUTES=15
